{
  "name": "mofa-comic",
  "version": "0.4.6",
  "make_type": "comic",
  "content_type_description": "Multi-panel comic strips with AI-generated panel art. Layout can be horizontal, vertical, or grid.",
  "timeout_secs": 1800,
  "binaries": {
    "darwin-aarch64": {
      "url": "https://github.com/mofa-org/mofa-skills/releases/download/v1.0.1/mofa-darwin-aarch64.tar.gz"
    }
  },
  "tools": [
    {
      "name": "mofa_comic",
      "spawn_only": true,
      "spawn_only_message": "SUCCESS: Comic generation is now running in background. The comic image will be automatically delivered when ready. No further action needed for this request.",
      "description": "Generate multi-panel comic strips with AI-generated art. Runs in background — do NOT wait for it.",
      "input_schema": {
        "type": "object",
        "properties": {
          "panels": {
            "type": "array",
            "description": "Array of panel objects",
            "items": {
              "type": "object",
              "properties": {
                "prompt": {
                  "type": "string",
                  "description": "Panel content description"
                },
                "refine_prompt": {
                  "type": "string",
                  "description": "Optional Qwen-Edit instruction to refine this panel after generation (e.g. 'make the sky more dramatic')"
                }
              },
              "required": [
                "prompt"
              ]
            }
          },
          "style": {
            "type": "string",
            "description": "Style template name (default: xkcd)",
            "default": "xkcd"
          },
          "out": {
            "type": "string",
            "description": "Output PNG file path. Use a relative path (e.g. output.png) — never use /tmp."
          },
          "work_dir": {
            "type": "string",
            "description": "Working directory for panel PNGs"
          },
          "layout": {
            "type": "string",
            "description": "Layout: horizontal, vertical, grid",
            "default": "horizontal"
          },
          "concurrency": {
            "type": "integer",
            "description": "Parallel generation limit (default: 3)"
          },
          "image_size": {
            "type": "string",
            "description": "Image resolution passed to Gemini (e.g. '1024x1024')"
          },
          "gutter": {
            "type": "integer",
            "description": "Gap between panels in pixels (default: 20)"
          },
          "refine": {
            "type": "boolean",
            "description": "Refine panels with Qwen-Edit (requires DASHSCOPE_API_KEY)"
          },
          "api": {
            "type": "string",
            "description": "API mode: rt (realtime, fast) or batch (50% cheaper, async)",
            "default": "rt",
            "enum": [
              "rt",
              "batch"
            ]
          }
        },
        "required": [
          "panels",
          "out"
        ]
      }
    }
  ]
}
