{
  "name": "mofa-infographic",
  "version": "0.4.6",
  "make_type": "infographic",
  "content_type_description": "Multi-section infographic images (PNG) with AI-generated visuals per section. Header/footer/middle variants, configurable style template.",
  "timeout_secs": 1800,
  "binaries": {
    "darwin-aarch64": {
      "url": "https://github.com/mofa-org/mofa-skills/releases/download/v1.0.1/mofa-darwin-aarch64.tar.gz"
    }
  },
  "tools": [
    {
      "name": "mofa_infographic",
      "spawn_only": true,
      "spawn_only_message": "SUCCESS: Infographic generation is now running in background. The infographic image will be automatically delivered when ready. No further action needed for this request.",
      "description": "Generate multi-section infographics with AI-generated visuals. Runs in background — do NOT wait for it.",
      "input_schema": {
        "type": "object",
        "properties": {
          "sections": {
            "type": "array",
            "description": "Array of section objects",
            "items": {
              "type": "object",
              "properties": {
                "prompt": {
                  "type": "string",
                  "description": "Section content description"
                },
                "variant": {
                  "type": "string",
                  "description": "Style variant for this section (e.g. 'header', 'normal', 'footer'). Defaults to 'header' for first section, 'footer' for last, 'normal' for middle sections."
                },
                "refine_prompt": {
                  "type": "string",
                  "description": "Optional Qwen-Edit instruction to refine this section after generation (e.g. 'increase contrast')"
                }
              },
              "required": [
                "prompt"
              ]
            }
          },
          "style": {
            "type": "string",
            "description": "Style template name (default: cyberpunk-neon)",
            "default": "cyberpunk-neon"
          },
          "out": {
            "type": "string",
            "description": "Output PNG file path. Use a relative path (e.g. output.png) — never use /tmp."
          },
          "work_dir": {
            "type": "string",
            "description": "Working directory for section PNGs"
          },
          "concurrency": {
            "type": "integer",
            "description": "Parallel generation limit (default: 3)"
          },
          "image_size": {
            "type": "string",
            "description": "Image resolution passed to Gemini (e.g. '1024x1024')"
          },
          "aspect": {
            "type": "string",
            "description": "Aspect ratio per section"
          },
          "gutter": {
            "type": "integer",
            "description": "Gap between sections in pixels (default: 0)"
          },
          "refine": {
            "type": "boolean",
            "description": "Refine sections with Qwen-Edit (requires DASHSCOPE_API_KEY)"
          },
          "api": {
            "type": "string",
            "description": "API mode: rt (realtime, fast) or batch (50% cheaper, async)",
            "default": "rt",
            "enum": [
              "rt",
              "batch"
            ]
          }
        },
        "required": [
          "sections",
          "out"
        ]
      }
    }
  ]
}
