{
  "name": "mofa-notebook-study",
  "version": "0.1.0",
  "description": "Generate source-grounded study guides, FAQs, quizzes, and flashcards from normalized notebook sources.",
  "skill_md_auto_inject": true,
  "tools": [
    {
      "name": "study_guide_generate",
      "description": "Generate a source-grounded study guide Markdown file from notebook sources.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace": { "type": "string" },
          "workspace_root": { "type": "string" },
          "focus": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        },
        "x-octos-host-config-keys": ["workspace_root"]
      }
    },
    {
      "name": "faq_generate",
      "description": "Generate a source-grounded FAQ Markdown file from notebook sources.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace": { "type": "string" },
          "workspace_root": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        },
        "x-octos-host-config-keys": ["workspace_root"]
      }
    },
    {
      "name": "quiz_generate",
      "description": "Generate a source-grounded quiz Markdown file from notebook sources.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace": { "type": "string" },
          "workspace_root": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        },
        "x-octos-host-config-keys": ["workspace_root"]
      }
    },
    {
      "name": "flashcards_generate",
      "description": "Generate source-grounded flashcards from notebook sources.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace": { "type": "string" },
          "workspace_root": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        },
        "x-octos-host-config-keys": ["workspace_root"]
      }
    }
  ]
}
