{
  "name": "mofa-notebook-source",
  "version": "0.1.0",
  "description": "Normalize workspace files into NotebookLM-like source manifests and chunks for source-grounded Octos chat.",
  "skill_md_auto_inject": true,
  "tools": [
    {
      "name": "source_import",
      "description": "Import a workspace-relative file as a notebook source. Creates notebook-sources/<source_id>/source.md, metadata.json, chunks.jsonl, and updates notebook-sources/manifest.json.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace": { "type": "string", "description": "Workspace root. Defaults to current directory." },
          "workspace_root": { "type": "string", "description": "Host-injected current workspace root." },
          "path": { "type": "string", "description": "Workspace-relative source path, for example uploads/report.md." },
          "title": { "type": "string", "description": "Human-readable source title." },
          "kind": { "type": "string", "description": "Optional source kind override." },
          "source_id": { "type": "string", "description": "Optional stable source id." }
        },
        "required": ["path"],
        "x-octos-host-config-keys": ["workspace_root"]
      },
      "env": [
        "GEMINI_API_KEY",
        "GEMINI_MODEL",
        "GEMINI_BASE_URL",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "VERTEX_SA_JSON",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "VERTEX_LOCATION",
        "VERTEX_BASE_URL",
        "VERTEX_ACCESS_TOKEN",
        "GOOGLE_OAUTH_ACCESS_TOKEN",
        "MOFA_NOTEBOOK_SOURCE_PROVIDER",
        "MOFA_NOTEBOOK_SOURCE_MODEL",
        "MOFA_NOTEBOOK_PROVIDER",
        "MOFA_NOTEBOOK_MODEL"
      ]
    },
    {
      "name": "source_normalize",
      "description": "Rebuild chunks and metadata for an existing notebook source id after source.md was edited.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace": { "type": "string", "description": "Workspace root. Defaults to current directory." },
          "workspace_root": { "type": "string", "description": "Host-injected current workspace root." },
          "source_id": { "type": "string", "description": "Notebook source id from notebook-sources/manifest.json." }
        },
        "required": ["source_id"],
        "x-octos-host-config-keys": ["workspace_root"]
      }
    },
    {
      "name": "source_manifest",
      "description": "Return the current notebook source manifest and source count.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace": { "type": "string", "description": "Workspace root. Defaults to current directory." },
          "workspace_root": { "type": "string", "description": "Host-injected current workspace root." }
        },
        "x-octos-host-config-keys": ["workspace_root"]
      }
    }
  ],
  "actions": [
    {
      "id": "source.import",
      "label": "Add source",
      "description": "Import uploaded files into source-grounded workspace sources.",
      "tags": ["source", "document"],
      "surfaces": ["studio.sources"],
      "execution": "background",
      "input_schema": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["paths"]
      },
      "ui_schema": {
        "accept": [
          ".md", ".markdown", ".txt", ".csv", ".json", ".html", ".htm",
          ".docx", ".pptx", ".xlsx", ".xlsm",
          ".pdf",
          ".jpg", ".jpeg", ".png", ".webp", ".gif",
          ".mp3", ".wav", ".m4a", ".aac", ".ogg",
          ".mp4", ".mov", ".webm", ".mkv"
        ]
      },
      "binding": {
        "type": "tool",
        "tool": "source_import",
        "input_mode": "file_each",
        "file_argument": "path",
        "file_materialization": "workspace_relative"
      }
    }
  ]
}
